{
  "name": "isyaratku",
  "private": true,
  "version": "0.1.0",
  "description": "Pengenal kosakata SIBI untuk komunikasi kelas di browser",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25 || >=26.0.0 <27"
  },
  "scripts": {
    "prepare:ml": "node scripts/export-ml.mjs",
    "prepare:worker": "node scripts/build-worker.mjs",
    "predev": "npm run prepare:browser-assets && npm run prepare:worker && node scripts/check-ml.mjs",
    "prebuild": "npm run prepare:browser-assets && npm run prepare:worker && node scripts/check-ml.mjs",
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run lint && npm run test:deploy && npm run test && npm run build",
    "prepare:browser-assets": "node scripts/prepare-browser-assets.mjs",
    "test:deploy": "node --test tests/deploy-assets.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@mediapipe/tasks-vision": "0.10.21",
    "@tensorflow/tfjs": "4.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
